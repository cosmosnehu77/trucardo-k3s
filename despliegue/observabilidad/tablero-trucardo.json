{
  "uid": "trucardo",
  "title": "Trucardo",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Primarios simultáneos",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (trucardo_nodo) (last_over_time(trucardo_primario[10s])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 1,
      "interval": "5s"
    },
    {
      "type": "timeseries",
      "title": "Rol por nodo (1 = primario)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (trucardo_nodo) (last_over_time(trucardo_primario[10s]))",
          "legendFormat": "N{{trucardo_nodo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "id": 2,
      "interval": "5s"
    },
    {
      "type": "timeseries",
      "title": "Época por nodo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (trucardo_nodo) (last_over_time(trucardo_epoca[10s]))",
          "legendFormat": "N{{trucardo_nodo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "id": 3,
      "interval": "5s"
    },
    {
      "type": "timeseries",
      "title": "Atraso de cada backup (ops)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (trucardo_nodo, backup) (last_over_time(trucardo_backup_atraso[10s]))",
          "legendFormat": "N{{trucardo_nodo}} → N{{backup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "id": 4,
      "interval": "5s"
    },
    {
      "type": "timeseries",
      "title": "Operaciones por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tipo) (rate(trucardo_operaciones_total[1m]))",
          "legendFormat": "{{tipo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "id": 5,
      "interval": "5s"
    },
    {
      "type": "timeseries",
      "title": "Latencia de confirmación p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(trucardo_confirmacion_duracion_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "id": 6,
      "interval": "5s"
    },
    {
      "type": "timeseries",
      "title": "Operaciones confirmadas sin todos los acks",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (trucardo_nodo) (increase(trucardo_operaciones_sin_acks_total[1m])) or on() vector(0)",
          "legendFormat": "N{{trucardo_nodo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "id": 7,
      "interval": "5s"
    },
    {
      "type": "logs",
      "title": "Logs de los nodos",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"trucardo-nodo.*\"}"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 8
    }
  ]
}
